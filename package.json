{
  "name": "markdown-studio",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "A local-first, Apple-inspired Markdown writing studio built with React and TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "vite",
    "ci": "npm run lint && npm run typecheck && npm test && npm run check:electron && npm run build",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/workspaceFs.cjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "dist:mac": "bash scripts/package-macos.sh",
    "dist:mac:dir": "npm run build && electron-builder --mac dir --arm64 --config.electronDist=node_modules/electron/dist",
    "desktop:package": "bash scripts/package-macos.sh",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "docx": "^9.15.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.3.0",
    "jsdom": "^31.0.0",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unified": "^11.0.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "studio.markdown.desktop",
    "productName": "Markdown studio",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Markdown studio ${version}",
      "artifactName": "Markdown-studio-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "MarkdownStudio",
      "artifactName": "Markdown-studio-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Markdown-studio-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Markdown-studio-${version}-${arch}-portable.${ext}"
    },
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "author": "Markdown studio",
  "engines": {
    "node": ">=22"
  }
}
